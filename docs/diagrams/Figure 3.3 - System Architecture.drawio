        <mxCell id="ad_e1" value="HTTP(S) — Inertia request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ad_browser" target="ad_routes">
