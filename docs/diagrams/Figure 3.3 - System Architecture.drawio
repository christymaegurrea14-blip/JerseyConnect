        </mxCell>
        <mxCell id="ad_middleware" value="Middleware&#10;(auth, admin/client role check, throttle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
