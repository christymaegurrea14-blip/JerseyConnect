<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="JerseyConnect capstone docs" version="24.0.0" type="device">
  <diagram id="architecture-diagram" name="Figure 3.3 - System Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ad_title" value="JerseyConnect — System Architecture Diagram" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ad_browser" value="Client Browser&#10;Vue 3 SPA (Inertia Pages)&#10;+ Leaflet Map (delivery address picker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
