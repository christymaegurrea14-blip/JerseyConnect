          <mxGeometry x="270" y="200" width="280" height="260" as="geometry" />
        </mxCell>

        <mxCell id="ad_routes" value="Routes (web.php, auth.php)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
